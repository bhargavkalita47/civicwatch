{
  "name": "civicwatch",
  "version": "2.5.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:worker": "npm run build && npx --yes wrangler@4.156.0 dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "check": "tsc -b",
    "validate:config": "node scripts/validate-config.mjs",
    "verify": "npm run test && npm run build && npm run validate:config && npm run validate:design && npm run validate:copy && npm run validate:mobile-nav",
    "deploy": "npx --yes wrangler@4.156.0 deploy",
    "deploy:dry-run": "npx --yes wrangler@4.156.0 deploy --dry-run --outdir .wrangler/dry-run",
    "validate:design": "node scripts/validate-design.mjs",
    "validate:copy": "node scripts/validate-copy.mjs",
    "validate:mobile-nav": "node scripts/validate-mobile-nav.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.4"
  }
}
