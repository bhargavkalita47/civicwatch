# Local development adapter. Set api only after shared backend and verified login are working.
VITE_SERVICE_MODE=mock
VITE_API_BASE_URL=/api/v1
VITE_SEED_DEMO=false
VITE_DEFAULT_CITY=Guwahati
VITE_DEFAULT_LAT=26.1716
VITE_DEFAULT_LNG=91.7606
# OSM raster tiles are the default: no key, account or token needed.
# For a large public launch, replace the tile host with a suitable production provider.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Only needed if a different tile host requires attribution in addition to OSM.
# VITE_TILE_ATTRIBUTION=© OpenStreetMap contributors · My Tile Provider
VITE_TILE_MAX_ZOOM=19


# For production traffic, use a dedicated Photon-compatible geocoder, not the demo host.
# VITE_GEOCODER_BASE_URL=https://your-geocoder.example
